{
  "name": "csc-121-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "pathmxCompatibility": {
    "baseline": "0.3.0",
    "updatePolicy": "exact-after-verification"
  },
  "scripts": {
    "onboard:preflight": "bun run scripts/instructor-onboarding.ts",
    "onboard": "bun run onboard:preflight && bun run check",
    "play": "pathmx play --print-url",
    "play:open": "pathmx play --print-url --open",
    "build": "pathmx build --clean",
    "check": "bun run scripts/check.ts",
    "share:course": "pathmx share paths/index.path.md"
  },
  "dependencies": {
    "@fellowhumans/pathmx": "0.3.0"
  }
}
